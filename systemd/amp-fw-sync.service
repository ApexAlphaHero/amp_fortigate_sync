[Unit]
Description=AMP FortiGate Sync — auto-syncs Docker port bindings to FortiGate firewall rules
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=amp-sync
Group=amp-sync

EnvironmentFile=/etc/amp-fw-sync/secrets.env

ExecStart=/opt/amp-fw-sync/venv/bin/python /opt/amp-fw-sync/src/main.py

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=amp-fw-sync

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/amp-fw-sync

[Install]
WantedBy=multi-user.target
